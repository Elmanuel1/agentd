{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateAgentdSecretsUnderTheKey",
      "Effect": "Allow",
      "Action": "secretsmanager:CreateSecret",
      "Resource": "arn:aws:secretsmanager:*:*:secret:PREFIX/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "agentd",
          "secretsmanager:KmsKeyArn": "KMS_KEY_ARN"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "workspace",
            "vault",
            "managed-by",
            "org",
            "api-key-id",
            "key-name",
            "key-hint"
          ]
        }
      }
    },
    {
      "Sid": "TagAgentdSecretsAtCreate",
      "Effect": "Allow",
      "Action": "secretsmanager:TagResource",
      "Resource": "arn:aws:secretsmanager:*:*:secret:PREFIX/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "agentd"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "workspace",
            "vault",
            "managed-by",
            "org",
            "api-key-id",
            "key-name",
            "key-hint"
          ]
        }
      }
    },
    {
      "Sid": "UseAgentdSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:RestoreSecret"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:PREFIX/*",
      "Condition": {
        "StringEquals": {
          "secretsmanager:ResourceTag/managed-by": "agentd"
        }
      }
    },
    {
      "Sid": "ListAgentdApiKeysForTheKeysCommand",
      "Effect": "Allow",
      "Action": "secretsmanager:ListSecrets",
      "Resource": "*"
    },
    {
      "Sid": "NeverDeleteWithoutRecovery",
      "Effect": "Deny",
      "Action": "secretsmanager:DeleteSecret",
      "Resource": "*",
      "Condition": {
        "Bool": {
          "secretsmanager:ForceDeleteWithoutRecovery": "true"
        }
      }
    },
    {
      "Sid": "CheckTheKeyAtBoot",
      "Effect": "Allow",
      "Action": "kms:DescribeKey",
      "Resource": "KMS_KEY_ARN"
    },
    {
      "Sid": "UseTheKeyOnlyThroughSecretsManagerForAgentdSecrets",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "KMS_KEY_ARN",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "secretsmanager.*.amazonaws.com",
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:*:*:secret:PREFIX/*"
        }
      }
    }
  ]
}
