{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccountAdministersButNeverUsesTheKey",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::ACCOUNT_ID:root" },
      "Action": [
        "kms:Create*",
        "kms:Describe*",
        "kms:Enable*",
        "kms:List*",
        "kms:Put*",
        "kms:Update*",
        "kms:Revoke*",
        "kms:Disable*",
        "kms:Get*",
        "kms:Delete*",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentdChecksTheKey",
      "Effect": "Allow",
      "Principal": { "AWS": "AGENTD_ROLE_ARN" },
      "Action": "kms:DescribeKey",
      "Resource": "*"
    },
    {
      "Sid": "AgentdUsesTheKeyOnlyThroughSecretsManager",
      "Effect": "Allow",
      "Principal": { "AWS": "AGENTD_ROLE_ARN" },
      "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "secretsmanager.*.amazonaws.com",
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:*:ACCOUNT_ID:secret:PREFIX/*"
        }
      }
    }
  ]
}
