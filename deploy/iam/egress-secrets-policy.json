{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCredentialValuesOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:PREFIX/*"
    },
    {
      "Sid": "NeverTheApiKeyRecordsOrThePepper",
      "Effect": "Deny",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:PREFIX/system/*"
    }
  ]
}
