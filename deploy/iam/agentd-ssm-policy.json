{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteReadAndDeleteParametersUnderThePrefix",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:DeleteParameter"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/PREFIX/*"
    },
    {
      "Sid": "TagAgentdParametersAtCreate",
      "Effect": "Allow",
      "Action": "ssm:AddTagsToResource",
      "Resource": "arn:aws:ssm:*:*:parameter/PREFIX/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "agentd"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "workspace",
            "vault",
            "managed-by",
            "credential_type"
          ]
        }
      }
    },
    {
      "Sid": "CheckTheKeyAtBoot",
      "Effect": "Allow",
      "Action": "kms:DescribeKey",
      "Resource": "KMS_KEY_ARN"
    },
    {
      "Sid": "UseTheKeyOnlyThroughParameterStoreForAgentdParameters",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "KMS_KEY_ARN",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "ssm.*.amazonaws.com",
          "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:*:*:parameter/PREFIX/*"
        }
      }
    }
  ]
}
